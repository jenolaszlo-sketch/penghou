<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Penghou.IO.Protocols</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
    <EnableStrictModeForBaselineValidation>true</EnableStrictModeForBaselineValidation>
    <Title>Penghou I/O Protocols</Title>
    <Description>Versioned resource identity and path protocol implementations shared by Penghou I/O contracts and providers.</Description>
    <PackageTags>Penghou;resource-io;protocols;identity;paths</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Penghou.IO.Identity.Abstractions\Penghou.IO.Identity.Abstractions.csproj" />
    <None Remove="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../README.md'))" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
