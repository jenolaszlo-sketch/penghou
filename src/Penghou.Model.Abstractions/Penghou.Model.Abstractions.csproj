<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Penghou.Model.Abstractions</AssemblyName>
    <RootNamespace>Penghou.Model.Abstractions</RootNamespace>
    <Title>Penghou Model Abstractions</Title>
    <Authors>Penghou contributors</Authors>
    <Description>Neutral contracts for governed model transports.</Description>
    <PackageId>Penghou.Model.Abstractions</PackageId>
    <PackageTags>Penghou;model;transport;abstractions</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageVersion>0.1.0-preview.1</PackageVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="README.md" />
    <None Remove="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../README.md'))" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
